+        }
+
+        // Inner solid shutter / record circle
+        Rectangle {
+            id: innerShutter
+            anchors.centerIn: parent
+            width: shutterArea.width - 12
+            height: app.isRecording ? (shutterArea.height / 2) : width
+            radius: app.isRecording ? 6 : (width / 2)
+            color: app.isVideoMode ? "#ff3b30" : "white"
+
+            Behavior on width { NumberAnimation { duration: 150 } }
+            Behavior on height { NumberAnimation { duration: 150 } }
+            Behavior on radius { NumberAnimation { duration: 150 } }
+            Behavior on color { ColorAnimation { duration: 150 } }
+        }
+
+        MouseArea {
+            anchors.fill: parent
+            onPressed: {
+                innerShutter.scale = 0.88
+                streamView.vibrate(30)
+            }
+            onReleased: {
+                innerShutter.scale = 1.0
+            }
+            onCanceled: {
+                innerShutter.scale = 1.0
+            }
+            onClicked: {
+                if (app.remainingCountdown > 0) {
+                    // Cancel ongoing countdown
+                    countdownTimer.stop()
+                    app.remainingCountdown = 0
+                    return
+                }
+
+                if (!app.isVideoMode && app.countdownSeconds > 0) {
+                    app.remainingCountdown = app.countdownSeconds
+                    countdownTimer.start()
+                    streamView.vibrate(50)
+                } else {
+                    executeCapture()
+                }
+            }
+        }
+    }
+
+    function executeCapture() {
+        streamView.sendCommand("capture")
+        streamView.vibrate(60)
+        if (!app.isVideoMode) {
+            captureFlash.trigger()
+        }
+    }
+
+    // Countdown timer runner
+    Timer {
+        id: countdownTimer
+        interval: 1000
+        repeat: true
+        onTriggered: {
+            app.remainingCountdown--
