-    CaptureSession {
-        videoOutput: output
+        onCommandReceived: (action, payload) => {
+            if (action === "photo_captured") {
+                captureFlash.trigger()
+                app.statusText = "Photo Captured!"
+                app.statusColor = "#ffd700"
