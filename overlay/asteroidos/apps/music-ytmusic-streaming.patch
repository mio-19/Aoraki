+    function fetchStations() {
+        var xhr = new XMLHttpRequest()
+        xhr.onreadystatechange = function() {
+            if (xhr.readyState === XMLHttpRequest.DONE && xhr.status === 200) {
+                try {
+                    var res = JSON.parse(xhr.responseText)
+                    if (res && res.stations && res.stations.length > 0) {
+                        ytPlaylists = res.stations
+                    }
+                } catch (e) {
+                    console.log("Failed to parse ytmusicd stations: " + e)
+                }
+            }
+        }
+        xhr.open("GET", resolverHost + "/api/stations", true)
+        xhr.send()
+    }
+
+    function playCurrentTrack() {
+        var track = ytPlaylists[currentTrackIndex]
+        if (!track) return
+        standalonePlayer.stop()
+        standalonePlayer.source = resolverHost + "/stream?id=" + track.id
+        standalonePlayer.play()
+    }
+
+    Component.onCompleted: {
+        fetchStations()
+    }
 
